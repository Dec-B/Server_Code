using System;
using System.Net;
using System.Net.Sockets;
using System.Text;
using System.Collections.Generic;
using System.IO;
using System.Runtime.Serialization.Formatters.Binary;

namespace Server_Creation
{
    // The Packet class | Gets the raw data and information, keeps as a object rather than bytes. 
    internal class Packet
    {
        public byte[] Data { get; private set; }
        public int Length { get; private set; }
        public EndPoint Sender { get; private set; }

        public Packet(byte[] data, int length, EndPoint sender)
        {
            Data = data;
            Length = length;
            Sender = sender;
        }

        // Truns byte array into a string 
        public string GetMessageString()
        {
            return Encoding.ASCII.GetString(Data, 0, Length);
        }
    }

    internal class Server
    {
        private Socket serverSocket;
        private IPEndPoint endpoint;
        private int bufferSize;
        private string defaultReply;

        // Sets up variables for server
        public Server(string ipAddress, int port, int packetSize, string replyMessage)
        {
            // IPAddress.Parse converts string into a viable object (IP) for "IPEndPoint" to read
            IPAddress address = IPAddress.Parse(ipAddress);
            endpoint = new IPEndPoint(address, port);

            bufferSize = packetSize;
            defaultReply = replyMessage;
        }

        // Prepares and opens the server socket.
        public void Initialize()
        {
            serverSocket = new Socket(AddressFamily.InterNetwork, SocketType.Dgram, ProtocolType.Udp);
            serverSocket.Blocking = false; // Unblocks Socket
            serverSocket.Bind(endpoint);

            Console.WriteLine("Server initialized on " + endpoint.ToString());
        }

        // Handles the listening as well as the server inputs 
        public void Run()
        {
            bool isRunning = true;
            IPEndPoint sender = new IPEndPoint(IPAddress.Any, 0);
            EndPoint remote = (EndPoint)(sender);

            Console.WriteLine("=== SERVER COMMANDS ===");
            Console.WriteLine("Type 'exit' to safely shut down the server.");
            Console.WriteLine("Type 'msg [your text]' to change the welcome message.");
            Console.WriteLine("(Note: Pressing a key pauses the server until you press Enter)");
            Console.WriteLine("=======================");

            while (isRunning)
            {
              
                try
                {
                    // Number to be adjusted, powers of 2 prefered, game would want smaller optimised packets. Must be within loop to reset at start.
                    byte[] data = new byte[bufferSize];
                    int recv = serverSocket.ReceiveFrom(data, ref remote);

                    // Instance of packet to contain data
                    Packet receivedPacket = new Packet(data, recv, remote);

                    // Keeps core loop clean
                    ProcessPacket(receivedPacket);
                    SendMessage(remote, defaultReply);
                }
                catch (SocketException ex) when (ex.SocketErrorCode == SocketError.WouldBlock)
                {
                   
                }

                
                // Used to stop any freezing when there is no input.
                if (Console.KeyAvailable)
                {
                    // If server is trying to do something, stop recieving inputs from network until done
                    string input = Console.ReadLine();

                    if (!string.IsNullOrWhiteSpace(input))
                    {
                        if (input.ToLower() == "exit")
                        {
                            Console.WriteLine("Initiating shutdown sequence...");
                            isRunning = false; 
                        }
                        else if (input.ToLower().StartsWith("msg "))
                        {
                            defaultReply = input.Substring(4);
                            Console.WriteLine($"\n[SYSTEM] Welcome message successfully changed to: '{defaultReply}'\n");
                        }
                        else
                        {
                            Console.WriteLine("[SYSTEM] Unknown command.");
                        }
                    }
                }

               
            }
            serverSocket.Close();
            Console.WriteLine("Server network socket closed.");
        }

        // Organization stuff, neatly showcases information
        private void ProcessPacket(Packet packet)
        {
            // By casting the EndPoint back to an IPEndPoint, we gain access to Address and Port properties.
            IPEndPoint senderInfo = packet.Sender as IPEndPoint;

            Console.WriteLine("--- New Packet Received ---");
            Console.WriteLine($"IP Address : {senderInfo.Address}");
            Console.WriteLine($"Port       : {senderInfo.Port}");
            Console.WriteLine($"Message    : {packet.GetMessageString()}");
            Console.WriteLine("---------------------------");
        }

        
        private void SendMessage(EndPoint targetRemote, string messageText)
        {
            // Convert to bytes before sending it across nmetwork
            byte[] data = Encoding.ASCII.GetBytes(messageText);
            serverSocket.SendTo(data, data.Length, SocketFlags.None, targetRemote);
        }
    }

    internal class Program
    {
        static void Main(string[] args)
        {
            // Change everything from here, easy to locate. "127.0.0.1" is used as it is the localhost | 62115 is the port number I have chosen for this test build unsure of any potential clashes as "IANA" only appears to have a count up to 49151 registered.
            string serverIP = "127.0.0.1";
            int serverPort = 62115;
            int maxPacketSize = 1024;
            string welcomeMessage = "Message recieved by the Server - You have connected!";

            // Creates an Instance of the server with all the correct variables.
            Server myServer = new Server(serverIP, serverPort, maxPacketSize, welcomeMessage);

          
            myServer.Initialize();
            myServer.Run();

            Console.WriteLine("Press any key to close the window...");
            Console.ReadKey();
        }
    }
}
