using System;
using System.Net;
using System.Net.Sockets;
using System.Text;
using System.Collections.Generic;
using System.IO;
using System.Runtime.Serialization.Formatters.Binary;
using System.Security.Cryptography.X509Certificates;

namespace Server_Creation
{
    internal class Program
    {
        static void Main(string[] args)
        {
            int recv;
            

            // IP and Port | IPAddress.Parse converts string into a viable object (IP) for "IPEndPoint" to read, "127.0.0.1" is used as it is the localhost | 62115 is the port number I have chosen for this test build unsure of any potential clashes as "IANA" only appears to have a count up to 49151 registered.
            IPAddress address = IPAddress.Parse("127.0.0.1");
            IPEndPoint endpoint = new IPEndPoint(address, 62115);

            Socket serverSocket = new Socket(AddressFamily.InterNetwork, SocketType.Dgram, ProtocolType.Udp);

            serverSocket.Bind(endpoint);

            Console.WriteLine("Server open..."); ;
            // Console.ReadLine();

            IPEndPoint sender = new IPEndPoint(IPAddress.Any, 0);
            EndPoint remote = (EndPoint)(sender);

            while (true)
            {
                // Number to be adjusted, powers of 2 prefered, game would want smaller optimised packets. Must be within loop to reset at start.
                byte[] data = new byte[1024];
                recv = serverSocket.ReceiveFrom(data, ref remote);

                // Show the data of the packet by converting the byte array to a string, would need to be more advanced/exact in future if things aren't just strings.
                Console.WriteLine("Message Recived from " + remote.ToString());
                Console.WriteLine(Encoding.ASCII.GetString(data, 0, recv));

                string welcomeMessage = "Message recieved by the Server - You have connected!";

                // Convert to bytes before sending it across nmetwork
                data = Encoding.ASCII.GetBytes(welcomeMessage);

                serverSocket.SendTo(data, data.Length, SocketFlags.None, remote);
            }
        }
    }
}
